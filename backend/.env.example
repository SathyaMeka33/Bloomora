# Bloomora Backend Environment Variables
# Copy this to .env and fill in your values

SECRET_KEY=django-insecure-bloomora-change-this-in-production-abcdef123456

# Set to False in production
DEBUG=True

# Comma-separated allowed hosts
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS - frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI - Get from Google AI Studio
GEMINI_API_KEY=your-gemini-api-key-here

# Payments - Get from Razorpay Dashboard
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# PostgreSQL (for production - leave blank to use SQLite in development)
# DB_NAME=bloomora
# DB_USER=bloomora
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
